          "request": {
            "name": "Plaid Get details of all supported institutions",
            "description": {
              "content": "Returns a JSON response containing details on all financial institutions currently supported by Plaid. Because Plaid supports thousands of institutions, results are paginated.\n\nIf there is no overlap between an institution’s enabled products and a client’s enabled products, then the institution will be filtered out from the response. As a result, the number of institutions returned may not match the count specified in the call.",
              "type": "text/plain"
            },
